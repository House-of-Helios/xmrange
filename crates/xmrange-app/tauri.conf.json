{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XMRange",
  "identifier": "house.helios.xmrange",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "XMRange", "create": false,
      "width": 1280, "height": 970, "minWidth": 960, "minHeight": 600, "resizable": true,
      "titleBarStyle": "Overlay", "hiddenTitle": true
    }],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true, "targets": "all", "icon": ["icons/icon.png"], "category": "Utility",
    "macOS": { "minimumSystemVersion": "11.3" }
  }
}
